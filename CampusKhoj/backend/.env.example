# CampusKhoj API Environment Configuration
FLASK_ENV=development
DEBUG=True
PORT=5000

# Database Configuration (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=campuskhoj
DB_POOL_SIZE=10

# Security (JWT secret MUST be at least 32 characters)
JWT_SECRET=super_secret_campuskhoj_jwt_key_32_characters_minimum_prod!
JWT_ACCESS_MINUTES=60
JWT_PWD_CHANGE_MINUTES=15

# Upload & Media
MEDIA_ROOT=./media
MAX_CONTENT_LENGTH_MB=3

# Rate limiting & Lockout
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15
MATCH_THRESHOLD=50

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3001,http://127.0.0.1:3002

